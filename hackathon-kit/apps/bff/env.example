# Copy to .env locally — do NOT commit real secrets to OnlyGo
ADDR=:8000
CORS_ORIGIN=http://localhost:5173
# fixture | raw | live  (Damir: dump→raw, port-forward→live)
DATA_MODE=fixture
FIXTURE_PATH=fixtures/sample-activity.json
RAW_DUMP_PATH=../../fixtures/raw/events.json
# Live / dump (Damir) — REST slice has args; ClickHouse does NOT
RR_BASE_URL=https://localhost:9000
RR_TOKEN=
RR_USER=admin
RR_PASSWORD=
RR_INSECURE_TLS=true
RR_SLICE_SIZE=100
RR_PAGES=5
# right = history from now; left = futureward (wrong for finished gen-activity)
RR_SLICE_DIR=right

